+;; Find the node's dest bypassing casts.
+(defun node-principal-dest (node)
+  (declare (type node node))
+  (labels ((%go (node)
+             (let ((dest (node-dest node)))
+               (if (cast-p dest)
+                   (node-principal-dest dest)
+                   dest))))
+    (%go node)))
