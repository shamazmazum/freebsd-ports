Author: Vasily Postnicov <shamaz.mazum@gmail.com>
Date:   Sun Feb 1 17:08:25 2026 +0300

    Improve NODE-CONSERVATIVE-TYPE for conses.

    This means that you can elide type declarations for cons args
    if you already have a FTYPE declaration and aren't doing bad things
    to the arg. E.g.:

    (declaim (ftype (function ((cons fixnum fixnum)) (values t &optional)) foo))
    (defun foo (x)
      (declare (optimize (speed 3))
               ;; You can remove the following declaration and get this
               ;; function compiled without notes.
               #+nil
               (type (cons fixnum fixnum) x))
      (logand (car x) (cdr x)))
--- src/compiler/ir1opt.lisp.orig	2026-08-28 16:31:42 UTC
+++ src/compiler/ir1opt.lisp
@@ -240,21 +240,36 @@
   (let* ((derived-values-type (node-derived-type node))
          (derived-type (single-value-type derived-values-type)))
     (if (ref-p node)
-        (let ((leaf (ref-leaf node)))
+        (let ((leaf (ref-leaf node))
+              (cons-type (specifier-type 'cons)))
           (if (and (basic-var-p leaf)
                    (cdr (leaf-refs leaf)))
-              (coerce-to-values
-               (if (eq :declared (leaf-where-from leaf))
-                   (let ((leaf-type (leaf-type leaf))
-                         (cons-type (specifier-type 'cons)))
-                     ;; If LEAF-TYPE is (or null some-cons-type) and
-                     ;; DERIVED-TYPE is known to be non-null, use
-                     ;; SOME-CONS-TYPE in that case, because a cons
-                     ;; can't become null.
-                     (if (csubtypep derived-type cons-type)
-                         (type-intersection leaf-type cons-type)
-                         leaf-type))
-                   (conservative-type derived-type)))
+              (or (and
+                   ;; Works only for conses
+                   (csubtypep derived-type cons-type)
+                   ;; All functions for which this var is an arg are
+                   ;; pure.
+                   (every
+                    (lambda (ref)
+                      (let ((dest (node-principal-dest ref)))
+                        (and (combination-p dest)
+                             (flushable-combination-p dest))))
+                    (leaf-refs leaf))
+                   ;; This var is not assigned to and we have no
+                   ;; other dests.
+                   (null (basic-var-sets leaf))
+                   derived-values-type)
+                  (coerce-to-values
+                   (if (eq :declared (leaf-where-from leaf))
+                       (let ((leaf-type (leaf-type leaf)))
+                         ;; If LEAF-TYPE is (or null some-cons-type) and
+                         ;; DERIVED-TYPE is known to be non-null, use
+                         ;; SOME-CONS-TYPE in that case, because a cons
+                         ;; can't become null.
+                         (if (csubtypep derived-type cons-type)
+                             (type-intersection leaf-type cons-type)
+                             leaf-type))
+                       (conservative-type derived-type))))
               derived-values-type))
         derived-values-type)))
 
